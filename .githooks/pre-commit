#!/usr/bin/env bash
# =============================================================================
# GrowthLens pre-commit 훅 — 비밀값·데이터 유출 차단 (외부 라이브러리 불필요)
#
# 목적: .gitignore 는 "실수로 add" 만 막고 `git add -f`, 이미 추적 중인 파일,
#       코드 안에 직접 쓴 키는 막지 못한다. 이 훅이 커밋 직전에 한 번 더 검사한다.
# 검사: (1) 금지 파일명  (2) 추가된 줄의 키·토큰·비밀번호 패턴  (3) 대용량 파일
# 활성화(클론마다 1회): git config core.hooksPath .githooks
# 우회: git commit --no-verify — 팀 합의 없이 사용 금지
# 설정: GL_MAX_FILE_KB (기본 5120KB)
# 4개 레포에 동일 파일을 둔다. 수정 시 전 레포 함께 변경.
# =============================================================================
set -u
MAX_KB="${GL_MAX_FILE_KB:-5120}"
fail=0
block() { echo "  ✖ $1"; fail=1; }

# (2) 토큰 형식이 명확한 키 패턴
KEY_PATTERNS='github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|sk-ant-[A-Za-z0-9_-]{16,}|sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
# (2) "비밀값 이름 = 값" 형태 (값 16자 이상)
ASSIGN_PATTERN='(SECRET|TOKEN|PASSWORD|PASSWD|API_?KEY|ACCESS_KEY|PRIVATE_KEY|SERVICE_KEY)[A-Za-z_]*["'"'"']?[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9/+_.=-]{16,}'
# (2) 접속 문자열 안의 비밀번호 (scheme://user:pw@host)
URL_PW_PATTERN='://[^/:@[:space:]]+:[^@[:space:]]+@'
# 예시·placeholder 로 허용하는 값
ALLOW_PATTERN='your_|undecided|placeholder|changeme|<[^>]*>|xxxx|user:password@|\$\{'

while IFS= read -r -d '' f; do
  base="${f##*/}"
  # (1) 금지 파일명
  case "$base" in
    .env.example) ;;
    .env|.env.*|*.env|.envrc|*.pem|*.key|*.p12|*.pfx|*.jks|*.keystore|id_rsa*|id_ed25519*|\
    credentials*.json|*service-account*.json|*service_account*.json|client_secret*.json|token.json|.netrc)
      block "비밀값 파일: $f"; continue ;;
  esac
  case "$f" in .githooks/*) continue ;; esac

  # (3) 대용량 파일
  size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  if [ "$size" -gt $((MAX_KB * 1024)) ]; then
    block "대용량 파일 $((size / 1024))KB > ${MAX_KB}KB: $f (데이터·모델은 커밋 금지)"
  fi

  # (2) 추가된 줄 내용 검사 (바이너리 제외)
  added=$(git diff --cached -U0 --no-color --diff-filter=ACMR -- "$f" | grep -E '^\+' | grep -vE '^\+\+\+' || true)
  [ -z "$added" ] && continue
  if echo "$added" | grep -qE "$KEY_PATTERNS"; then
    block "API 키·토큰·개인키로 보이는 값: $f"
  fi
  if echo "$added" | grep -E "$ASSIGN_PATTERN|$URL_PW_PATTERN" | grep -vqiE "$ALLOW_PATTERN"; then
    block "비밀값 할당 또는 접속 비밀번호로 보이는 값: $f"
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "커밋이 차단되었습니다. 비밀값은 .env 에만 두고(.env.example 에는 your_... 같은 placeholder), 데이터·모델은 커밋하지 마세요."
  echo "스테이징 취소: git restore --staged <파일>"
  exit 1
fi
exit 0
